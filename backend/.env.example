# ─── Required: API keys (keep these secret; never commit real values) ─────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed frontend origins (your live site in production).
FRONTEND_URL=http://localhost:3000
# Set to "production" when hosted (turns on rate limiting + hides error details).
NODE_ENV=development

# ─── Private demo: access code (leave blank locally = open) ───────────────────
# Set this to any string in production; give it to your testers. When set, the
# processing endpoints require it and the site shows an access-code screen.
ACCESS_CODE=

# ─── Spend protection ─────────────────────────────────────────────────────────
# Max minutes of SOURCE video the whole demo will process per day (resets at
# midnight UTC). Default 180.
DAILY_PROCESSING_MINUTES=180
# Max upload size: starter | pro | unlimited, or a number of bytes. Default unlimited.
# MAX_FILE_SIZE=pro

# ─── Optional: FFmpeg path override (if not in system PATH) ───────────────────
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
