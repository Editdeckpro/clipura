{
  "name": "clip-factory-backend",
  "version": "1.0.0",
  "description": "Podcast-to-clips processing backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "uploads/*",
      "outputs/*",
      "temp/*",
      "bin/*"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@distube/ytdl-core": "^4.16.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "uuid": "^11.0.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
